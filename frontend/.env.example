# COS frontend environment template (M01-P02-T01)
# Copy to `.env.local` (gitignored via `.env*.local`). Do not commit real secrets.
#
# Keys below match `src/config/env.ts`. Next.js inlines `NEXT_PUBLIC_*` at build time.
# `src/lib/axios.ts` reads `process.env.NEXT_PUBLIC_API_BASE_URL` and
# `process.env.NEXT_PUBLIC_API_TIMEOUT` directly — it does not import `env.ts`.
# If `NEXT_PUBLIC_API_BASE_URL` is unset, axios `baseURL` is undefined (relative
# to the Next.js origin). There is no axios fallback URL in code.
#
# Production API: https://api.woofskis.com/api/v1
# Set NEXT_PUBLIC_API_BASE_URL at build time. Do not use localhost in production.
# Docker Compose (dev/prod) does not pass `NEXT_PUBLIC_API_*` (only NODE_ENV, and
# WATCHPACK_POLLING in docker-compose.dev.yml). Dockerfile.prod inlines NEXT_PUBLIC_*
# at `npm run build`; a production API host is NOT SPECIFIED.
# `.gitignore` ignores `.env*.local` and un-ignores `.env.example`. A non-local
# `.env` is not ignored by the current frontend `.gitignore`.

# Public app metadata. Zod defaults in env.ts if unset.
# `src/config/site.ts` currently hardcodes name/description and reads APP_URL
# with fallback `http://localhost:3000` (does not import env.ts).
NEXT_PUBLIC_APP_NAME="Woofskis"
NEXT_PUBLIC_APP_DESCRIPTION="High performance contest and tournament management platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fastify API prefix. Aligns with frozen backend PORT default 5000 and
# SYSTEM_CONSTANTS.API_PREFIX (`/api/v1`) — see M01-P01-T02 / api-map.md.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api/v1"

# Axios timeout in milliseconds. `src/lib/axios.ts` uses
# Number(process.env.NEXT_PUBLIC_API_TIMEOUT). If unset, Number(undefined) is NaN.
# Required timeout policy: NOT SPECIFIED beyond this existing key.
NEXT_PUBLIC_API_TIMEOUT="15000"

# Names listed in env.ts. Axios currently hardcodes localStorage key
# `cos_auth_token` rather than these variables (see M01-P02-T02).
# HTTP-cookie vs localStorage, and refresh-token transport: NOT SPECIFIED.
NEXT_PUBLIC_AUTH_COOKIE_NAME="cos_auth_token"
NEXT_PUBLIC_REFRESH_COOKIE_NAME="cos_refresh_token"

# Next.js also sets NODE_ENV itself. env.ts enum: development | test | production;
# default `development`.
NODE_ENV="development"

# Deployment organization slug. Not a UUID. Production is woofskis.
NEXT_PUBLIC_DEPLOYMENT_ORGANIZATION_SLUG="woofskis"
